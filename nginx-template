server {
        listen 80;
        server_name networkv1.getsession.org;

        client_max_body_size 10M;

        # Onion request endpoints: legitimate payloads are a few KB; cap the
        # body well below the global limit so oversized garbage is rejected
        # before it reaches the decrypt worker.
        location ~ ^/(oxen|loki)/v[34]/lsrpc$ {
                client_max_body_size 64k;

                include /etc/nginx/uwsgi_params;
                uwsgi_pass unix:///home/network-api/api/network-api.wsgi;
        }

        location / {
                include /etc/nginx/uwsgi_params;
                uwsgi_pass unix:///home/network-api/api/network-api.wsgi;
        }

        access_log /var/log/nginx/networkv1.getsession.org.access.log;
        error_log  /var/log/nginx/networkv1.getsession.org.log;
}

server {
        listen 443 ssl;
        server_name networkv1.getsession.org;

        client_max_body_size 10M;

        location ~ ^/(oxen|loki)/v[34]/lsrpc$ {
                client_max_body_size 64k;

                include /etc/nginx/uwsgi_params;
                uwsgi_pass unix:///home/network-api/api/network-api.wsgi;
        }

        location / {
                include /etc/nginx/uwsgi_params;
                uwsgi_pass unix:///home/network-api/api/network-api.wsgi;
        }

        access_log /var/log/nginx/networkv1.getsession.org.access.log;
        error_log  /var/log/nginx/networkv1.getsession.org.log;

    ssl_certificate /etc/letsencrypt/live/networkv1.getsession.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/networkv1.getsession.org/privkey.pem; # managed by Certbot
}
