# Strict endpoint allowlist: only the paths the API actually serves are
# proxied to uWSGI. Everything else (scanner noise like /.env, /index.php,
# /wp-admin, random paths) is answered with 404 by nginx and never reaches
# the application.

server {
        listen 80;
        server_name networkv1.getsession.org;

        # GET /info
        location = /info {
                limit_except GET { deny all; }
                include /etc/nginx/uwsgi_params;
                uwsgi_pass unix:///home/network-api/api/network-api.wsgi;
        }

        # GET /prices/<token>/<period> — path shape is checked here; the
        # token and period values are validated by the app (404 / 400).
        location ~ ^/prices/[A-Za-z0-9._-]+/[A-Za-z0-9]+$ {
                limit_except GET { deny all; }
                include /etc/nginx/uwsgi_params;
                uwsgi_pass unix:///home/network-api/api/network-api.wsgi;
        }

        # Onion request endpoints (POST only). Legitimate payloads are a
        # few KB; cap the body well below nginx's default limit so oversized
        # garbage is rejected before it reaches the decrypt worker.
        location ~ ^/(oxen|loki)/v[34]/lsrpc$ {
                limit_except POST { deny all; }
                client_max_body_size 64k;
                include /etc/nginx/uwsgi_params;
                uwsgi_pass unix:///home/network-api/api/network-api.wsgi;
        }

        # Everything else: not served here.
        location / {
                return 404;
        }

        access_log /var/log/nginx/networkv1.getsession.org.access.log;
        error_log  /var/log/nginx/networkv1.getsession.org.log;
}

server {
        listen 443 ssl;
        server_name networkv1.getsession.org;

        location = /info {
                limit_except GET { deny all; }
                include /etc/nginx/uwsgi_params;
                uwsgi_pass unix:///home/network-api/api/network-api.wsgi;
        }

        location ~ ^/prices/[A-Za-z0-9._-]+/[A-Za-z0-9]+$ {
                limit_except GET { deny all; }
                include /etc/nginx/uwsgi_params;
                uwsgi_pass unix:///home/network-api/api/network-api.wsgi;
        }

        location ~ ^/(oxen|loki)/v[34]/lsrpc$ {
                limit_except POST { deny all; }
                client_max_body_size 64k;
                include /etc/nginx/uwsgi_params;
                uwsgi_pass unix:///home/network-api/api/network-api.wsgi;
        }

        location / {
                return 404;
        }

        access_log /var/log/nginx/networkv1.getsession.org.access.log;
        error_log  /var/log/nginx/networkv1.getsession.org.log;

    ssl_certificate /etc/letsencrypt/live/networkv1.getsession.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/networkv1.getsession.org/privkey.pem; # managed by Certbot
}
